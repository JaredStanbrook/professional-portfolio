// Copy to `wrangler.jsonc` and fill in your own values, then COMMIT it.
// This file is deployment configuration, not secrets: resource ids are
// useless without an account-scoped API token. Real secrets (JWT_SECRET,
// GITHUB_API_TOKEN, SMTP_PASS, SMS_PROVIDER_API_KEY) belong in `.dev.vars`
// locally and in encrypted secrets on Cloudflare -- never in `vars` below.
{
  "name": "professionalportfolio",
  "compatibility_date": "2025-01-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
  },
  // Staging / default environment. `wrangler deploy` with no --env flag
  // targets this one.
  "routes": [
    {
      "pattern": "dev.jared.stanbrook.me",
      "custom_domain": true,
    },
  ],
  // Every non-secret value the worker reads off `env`. Anything omitted here
  // is UNSET after a deploy -- `wrangler deploy` replaces the worker's
  // plain-text vars wholesale with this block.
  "vars": {
    "ENVIRONMENT": "staging",
    "AUTH_METHODS": "passkey,password",
    "SESSION_DURATION": "86400000",
    "SESSION_RENEWAL_THRESHOLD": "3600000",
    "MAX_SESSIONS_PER_USER": "5",
    "ALLOWED_EMAILS": "you@example.com",
    "MAX_FAILED_LOGIN_ATTEMPTS": "5",
    "LOCKOUT_DURATION": "900000",
    "REQUIRE_EMAIL_VERIFICATION": "false",
    "REQUIRE_PHONE_VERIFICATION": "false",
    "ROLES_AVAILABLE": "user,editor,admin",
    "ROLES_DEFAULT": "user",
    "ROLES_RESTRICTED": "admin",
    "PERMISSIONS_AVAILABLE": "blogs.create,blogs.read,blogs.update,blogs.delete,blogs.update.any,blogs.delete.any",
    "ROLES_INHERENT": "user:blogs.read,blogs.create,blogs.update;editor:blogs.read,blogs.create,blogs.update.any;admin:*",
    "RP_NAME": "Jared Stanbrook",
    "RP_ID": "dev.jared.stanbrook.me",
    "ORIGIN": "https://dev.jared.stanbrook.me",
    "PASSWORD_MIN_LENGTH": "8",
    "PASSWORD_REQUIRE_UPPERCASE": "true",
    "PASSWORD_REQUIRE_LOWERCASE": "true",
    "PASSWORD_REQUIRE_NUMBERS": "true",
    "PASSWORD_REQUIRE_SPECIAL": "true",
    "PIN_LENGTH": "6",
    "PIN_NUMBERS_ONLY": "true",
    "TOTP_ISSUER": "Jared Stanbrook",
    "TOTP_ALGORITHM": "SHA1",
    "TOTP_DIGITS": "6",
    "TOTP_PERIOD": "30",
    "JWT_EXPIRY": "86400000",
  },
  // Binding names must match `worker/types.ts` exactly: KV, DB, BLOG,
  // RATE_LIMITER, ASSETS.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "professional-portfolio-db",
      "database_id": "<your-d1-database-id>",
      "migrations_dir": "drizzle",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "<your-kv-namespace-id>",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BLOG",
      "bucket_name": "professional-portfolio-r2",
    },
  ],
  // Required: worker/index.ts rate-limits every request through this binding.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
  },
  "dev": {
    "port": 3000,
    "local_protocol": "http",
  },
  "env": {
    "production": {
      "routes": [
        {
          "pattern": "jared.stanbrook.me",
          "custom_domain": true,
        },
      ],
      // Environments do NOT inherit `vars` from the top level -- repeat every
      // key here with its production value.
      "vars": {
        "ENVIRONMENT": "production",
        "AUTH_METHODS": "passkey,password",
        "SESSION_DURATION": "86400000",
        "SESSION_RENEWAL_THRESHOLD": "3600000",
        "MAX_SESSIONS_PER_USER": "5",
        "ALLOWED_EMAILS": "you@example.com",
        "MAX_FAILED_LOGIN_ATTEMPTS": "5",
        "LOCKOUT_DURATION": "900000",
        "REQUIRE_EMAIL_VERIFICATION": "false",
        "REQUIRE_PHONE_VERIFICATION": "false",
        "ROLES_AVAILABLE": "user,editor,admin",
        "ROLES_DEFAULT": "user",
        "ROLES_RESTRICTED": "admin",
        "PERMISSIONS_AVAILABLE": "blogs.create,blogs.read,blogs.update,blogs.delete,blogs.update.any,blogs.delete.any",
        "ROLES_INHERENT": "user:blogs.read,blogs.create,blogs.update;editor:blogs.read,blogs.create,blogs.update.any;admin:*",
        "RP_NAME": "Jared Stanbrook",
        "RP_ID": "jared.stanbrook.me",
        "ORIGIN": "https://jared.stanbrook.me",
        "PASSWORD_MIN_LENGTH": "8",
        "PASSWORD_REQUIRE_UPPERCASE": "true",
        "PASSWORD_REQUIRE_LOWERCASE": "true",
        "PASSWORD_REQUIRE_NUMBERS": "true",
        "PASSWORD_REQUIRE_SPECIAL": "true",
        "PIN_LENGTH": "6",
        "PIN_NUMBERS_ONLY": "true",
        "TOTP_ISSUER": "Jared Stanbrook",
        "TOTP_ALGORITHM": "SHA1",
        "TOTP_DIGITS": "6",
        "TOTP_PERIOD": "30",
        "JWT_EXPIRY": "86400000",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "professional-portfolio-db",
          "database_id": "<your-d1-database-id>",
          "migrations_dir": "drizzle",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "<your-kv-namespace-id>",
        },
      ],
      "r2_buckets": [
        {
          "binding": "BLOG",
          "bucket_name": "professional-portfolio-r2",
        },
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 100,
            "period": 60,
          },
        },
      ],
      "observability": {
        "enabled": true,
      },
    },
  },
}
